# Sentry — copiá este archivo a .env.local y completá los valores.
# DSN del proyecto (Sentry → Project Settings → Client Keys). Es público: lo usa el navegador.
NEXT_PUBLIC_SENTRY_DSN=
# Token para subir source maps en el build (Sentry → Settings → Auth Tokens). Secreto.
SENTRY_AUTH_TOKEN=
# TEMPORAL (Fase 1): habilita /debug-sentry?token=<valor>. Sin valor, la ruta devuelve 404.
SENTRY_DEBUG_TOKEN=
